# Bind to loopback by default. Do not expose this service to the public internet.
UZURI_BRIDGE_HOST=127.0.0.1
UZURI_BRIDGE_PORT=38100

# Optional shared secret. If set, the web app must send it as a bearer token.
UZURI_BRIDGE_TOKEN=

# First supported transport: raw TCP printing, normally port 9100.
UZURI_PRINTER_ID=default
UZURI_PRINTER_NAME=XP-D281B
UZURI_PRINTER_PROTOCOL=TSPL
UZURI_PRINTER_CONNECTION=NETWORK
UZURI_PRINTER_HOST=192.168.1.100
UZURI_PRINTER_PORT=9100
