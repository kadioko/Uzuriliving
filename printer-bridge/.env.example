# Bind to loopback by default. Do not expose this service to the public internet.
UZURI_BRIDGE_HOST=127.0.0.1
UZURI_BRIDGE_PORT=38100

# Required when binding outside loopback; optional on loopback.
# If set, the web app must send it as a bearer token.
UZURI_BRIDGE_TOKEN=

# Only these websites may call the bridge from a browser. Add a local development
# origin explicitly if needed (for example http://localhost:3010).
UZURI_BRIDGE_ALLOWED_ORIGINS=https://uzuriliving.com,https://www.uzuriliving.com

# Select NETWORK, USB, or BLUETOOTH. USB uses an installed Windows printer queue;
# BLUETOOTH uses a paired Windows COM port.
UZURI_PRINTER_ID=default
UZURI_PRINTER_NAME=XP-D281B
UZURI_PRINTER_PROTOCOL=TSPL
UZURI_PRINTER_CONNECTION=NETWORK
UZURI_PRINTER_HOST=192.168.1.100
UZURI_PRINTER_PORT=9100

# USB (Windows spooler) example:
# UZURI_PRINTER_CONNECTION=USB
# UZURI_PRINTER_QUEUE=XP-D281B

# Bluetooth (paired Windows COM port) example:
# UZURI_PRINTER_CONNECTION=BLUETOOTH
# UZURI_PRINTER_SERIAL_PATH=COM3
# UZURI_PRINTER_BAUD_RATE=9600
